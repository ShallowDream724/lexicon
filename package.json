{
  "name": "lexicon-workbench",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "next dev",
    "dev:api": "go -C services/dictionary-api run ./cmd/dictionary-api -db ../../data/dictionary.db",
    "build": "node scripts/build-web.mjs",
    "start": "next start",
    "dictionary:import": "go -C services/dictionary-api run ./cmd/dictionary-import",
    "etymology:import": "go -C services/dictionary-api run ./cmd/etymology-import",
    "dictionary:benchmark": "go -C services/dictionary-api run ./cmd/dictionary-storage-benchmark",
    "dictionary:audit": "tsx scripts/audit-bundled-bilingual-corpus.ts",
    "test": "npm run test:contracts && npm run test:api && npm run build && npm run test:web",
    "test:api": "go -C services/dictionary-api test ./...",
    "test:contracts": "tsx --test tests/contracts/*.test.ts",
    "test:web": "node --test tests/rendered-html.test.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next"
  },
  "dependencies": {
    "idb": "^8.0.3",
    "lucide-react": "^1.28.0",
    "next": "16.3.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@serwist/turbopack": "9.5.12",
    "@swc/helpers": "0.5.23",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "esbuild": "0.28.1",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.0",
    "serwist": "9.5.12",
    "tsx": "^4.23.7",
    "typescript": "5.9.3"
  },
  "type": "module"
}
