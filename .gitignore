# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/.vinext/
/out/
/dist/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# environment files
.env*
!.env.example
!**/.env.example

# typescript
next-env.d.ts
*.tsbuildinfo
/data/
/.wrangler/
/outputs/
/work/
/$tmp/

# dictionary sources, generated runtimes, and media
*.apk
*.db
*.sqlite
*.sqlite3
*.zip
*.pdf
*.mp3
*.wav
rest-api.json
